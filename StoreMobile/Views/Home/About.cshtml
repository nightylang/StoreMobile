@{
    ViewData["Title"] = "About Us";
ViewData["ActiveBtnA"] = "active";

}

<div class="container Animation-After" style="margin-bottom: 100px;">
    <div class="about-page col " style="gap: 100px;">
        <!-- Main about content -->
        <div class="glass-card" style="margin-bottom: 2rem;">
            <h2>About E‑Commerce Rex</h2>
            <p>
                We are a next‑gen e‑commerce platform built with .NET 10, featuring HMAC‑protected ledger,
                JWT authentication, and a stunning glassmorphism UI. Our mission is to provide secure,
                scalable, and high‑performance solutions for modern businesses.
            </p>
            <ul>
                <li>🔐 Secure transactions with tamper‑evident ledger</li>
                <li>📦 Real‑time inventory management</li>
                <li>💳 Integrated banking wallet</li>
                <li>⏱️ Attendance tracking with QR and face recognition</li>
            </ul>
        </div>

        <!-- Team Section -->
        <div class="glass-card Animation-After">
            <h2 style="text-align:center; margin-bottom: 1.5rem;">Meet the Team</h2>
            <div class="team-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem;">
                <!-- Team Member 1 -->
                <div class="team-member glass-card Animation-After" style="text-align:center; padding:1.5rem; background:rgba(0, 117, 251, 0.4); border-color:rgba(85, 101, 247, 0.2);">
                    <div style="font-size:3.5rem; margin-bottom:0.5rem;">
                        <img src="~/team/tana.jpg" style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid rgba(168,85,247,0.3);" />
                    </div>
                    <h3 style="margin:0.2rem 0; color:darkblue;">Khoun Rotana</h3>
                    <p style="color:#0000ff; font-weight:600;">Project Lead</p>
                </div>

                <!-- Team Member 2 -->
                <div class="team-member glass-card Animation-After" style="text-align:center; padding:1.5rem; background:rgba(0, 117, 251, 0.4); border-color:rgba(85, 101, 247, 0.2);">
                    <div style="font-size:3.5rem; margin-bottom:0.5rem;">
                        <img src="~/team/nath.jpg" style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid rgba(168,85,247,0.3);" />
                    </div>
                    <h3 style="margin:0.2rem 0; color:darkblue;">Ear Amnath</h3>
                    <p style="color:#0000ff; font-weight:600;">Senior Developer</p>
                </div>

                <!-- Team Member 3 -->
                <div class="team-member glass-card Animation-After" style="text-align:center; padding:1.5rem; background:rgba(0, 117, 251, 0.4); border-color:rgba(85, 101, 247, 0.2);">
                    <div style="font-size:3.5rem; margin-bottom:0.5rem;">
                        <img src="~/team/rexgot.jpg" style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid rgba(168,85,247,0.3);" />
                    </div>
                    <h3 style="margin:0.2rem 0; color:darkblue;">Siev Eleang</h3>
                    <p style="color:#0000ff; font-weight:600;">UI/UX Designer</p>
                </div>
            </div>
        </div>
    </div>
</div>
