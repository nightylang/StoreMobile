@model StoreMobileV2.Models.ProductModel
@{
    ViewData["Title"] = "Delete User";
    Layout = "_LayoutAdmin";

}
<div class="container mt-4">
    <h2 class="text-danger">Delete Student</h2>
    <div class="alert alert-warning">
        Are you sure you want to delete this Product?
    </div>
    <div class="card">
        <div class="card-body">
            <div class="mb-3"><strong>Product ID:</strong> @Model.ID_product</div>
            <div class="mb-3"><strong>Product ID Name:</strong> @Model.id_name</div>
            <div class="mb-3"><strong>Product Name</strong> @Model.product_name</div>
            <div class="mb-3"><strong>Product Name</strong> @Model.product_price</div>
        </div>
    </div>
    <br />
    <form method="post" action="/Admin/DeleteProdConfirmed">
        <input type="hidden" name="id" value="@Model.ID_product" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a href="/Admin/Products" class="btn btn-secondary">Cancel</a>
    </form>
</div>