@{
	 Layout = "_LayoutAdmin";
}

<div class="admin-content col">
    <div class="row w-100">
        <div class="card-list">
              <div class="col">
                <div class="data-value">@ViewBag.TotalProducts</div>
                <div class="caption-value">Total Products</div>
              </div>
            </div>
            <div class="card-list">
              <div class="col">
                <div class="data-value">@ViewBag.TotalUsers</div>
                <div class="caption-value">Inverse Users</div>
              </div>
            </div>
            <div class="card-list">
              <div class="col">
                <div class="data-value">50</div>
                <div class="caption-value">Orders</div>
              </div>
            </div>
            <div class="card-list">
              <div class="col">
                <div class="data-value">$50</div>
                <div class="caption-value">Income</div>
              </div>
            </div>
     </div>
</div>