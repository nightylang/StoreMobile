@model StoreMobileV2.Models.UserModel
@{
    ViewData["Title"] = "Edit User";
    Layout = "_LayoutAdmin";

}
<div class="container mt-4">
    <h2>Edit User</h2>
    <form method="post" action="/Admin/EditUser">
        <input type="hidden" name="ID_user" value="@Model.ID_user" />
        <div class="mb-3">
            <label class="form-label">User Name</label>
            <input type="text" name="username" value="@Model.username" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <select name="ID_role" class="form-control">
                <option value="">-- Select Role --</option>
                <option value="1" selected="@(Model.ID_role == "Admin")">Admin</option>
                <option value="2" selected="@(Model.ID_role == "User")">User</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="text" name="password" value="@Model.password" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" value="@Model.email" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Update User</button>
        <a href="/Admin/Users" class="btn btn-secondary">Cancel</a>
    </form>
</div>